FROM docker.io/library/node:24-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config libssl-dev libgtk-3-dev libwebkit2gtk-4.1-dev \
    libayatana-appindicator3-dev librsvg2-dev patchelf ca-certificates \
    fonts-noto-cjk dbus-x11 x11-utils xdg-utils \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/home/dev/.cargo/bin:${PATH}"
WORKDIR /workspace
